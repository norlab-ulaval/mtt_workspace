#!/usr/bin/env bash
# Multi-repo workspace status for mtt_workspace.
#
# Default (no flags): full git status dump of the parent repo + nested repos
# (same behaviour as before).
#
# Flags:
#   --summary      compact health report + non-zero exit if dirty/warnings
#   --doctor       structural health checks (manifests, conflicts, packages…)
#   --dirty-only   only print nested repos that are not clean
#   --json         machine-readable summary (implies --summary)
#   --no-submodules
#                  skip `git submodule status` lines in the dump
#   -h, --help     this help
#
# Combining flags is allowed, e.g.:
#   ./scripts/status --summary --dirty-only
#   ./scripts/status --doctor --summary
#   ./scripts/status --json
#
# Exit codes:
#   0  clean (and doctor OK when --doctor)
#   1  dirty worktrees and/or doctor warnings
#   2  doctor failures (missing packages, conflict markers, broken links…)
set -euo pipefail

cd "$(dirname -- "${BASH_SOURCE[0]}")/.."

# ── colours (disabled when not a TTY or NO_COLOR is set) ─────────────────────
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_OK=$'\033[32m'
  C_WARN=$'\033[33m'
  C_FAIL=$'\033[31m'
  C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_RESET=$'\033[0m'
else
  C_OK=""; C_WARN=""; C_FAIL=""; C_BOLD=""; C_DIM=""; C_RESET=""
fi

# ── flags ────────────────────────────────────────────────────────────────────
mode_dump=true
mode_summary=false
mode_doctor=false
mode_dirty_only=false
mode_json=false
show_submodules=true

print_usage() {
  sed -n '2,28p' "$0" | sed 's/^# \?//'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --summary)
      mode_summary=true
      shift
      ;;
    --doctor)
      mode_doctor=true
      shift
      ;;
    --dirty-only)
      mode_dirty_only=true
      shift
      ;;
    --json)
      mode_json=true
      mode_summary=true
      shift
      ;;
    --no-submodules)
      show_submodules=false
      shift
      ;;
    -h|--help)
      print_usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      print_usage >&2
      exit 2
      ;;
  esac
done

# If the user only asked for summary/doctor/json, skip the full dump unless they
# also want dirty-only detail (dirty-only still prints short status for dirty repos).
if [[ "${mode_summary}" == true || "${mode_doctor}" == true ]]; then
  if [[ "${mode_dirty_only}" != true ]]; then
    mode_dump=false
  fi
fi
# --dirty-only alone keeps dump mode, filtered.
if [[ "${mode_dirty_only}" == true && "${mode_summary}" != true && "${mode_doctor}" != true ]]; then
  mode_dump=true
fi

# ── repo discovery ───────────────────────────────────────────────────────────
repo_roots=(".")

if git -C src/mtt_core rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  repo_roots+=("src/mtt_core")
fi

if [[ -d src/external ]]; then
  while IFS= read -r repo_dir; do
    if git -C "${repo_dir}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      repo_roots+=("${repo_dir}")
    fi
  done < <(find src/external -mindepth 1 -maxdepth 1 -type d | sort)
fi

repo_label() {
  local repo_dir="$1"
  if [[ "${repo_dir}" == "." ]]; then
    printf 'mtt_workspace'
  else
    printf '%s' "${repo_dir}"
  fi
}

repo_is_dirty() {
  local repo_dir="$1"
  # porcelain empty => clean working tree + index
  [[ -n "$(git -C "${repo_dir}" status --porcelain 2>/dev/null || true)" ]]
}

repo_branch_line() {
  local repo_dir="$1"
  git -C "${repo_dir}" status --short --branch 2>/dev/null | head -n 1
}

count_porcelain() {
  # prints: modified staged untracked total
  local repo_dir="$1"
  local porcelain modified staged untracked
  porcelain="$(git -C "${repo_dir}" status --porcelain 2>/dev/null || true)"
  if [[ -z "${porcelain}" ]]; then
    printf '0 0 0 0'
    return
  fi
  modified=0
  staged=0
  untracked=0
  while IFS= read -r line; do
    [[ -z "${line}" ]] && continue
    local xy="${line:0:2}"
    if [[ "${xy}" == "??" ]]; then
      untracked=$((untracked + 1))
    else
      # any non-space in index column => staged aspect
      if [[ "${xy:0:1}" != " " && "${xy:0:1}" != "?" ]]; then
        staged=$((staged + 1))
      fi
      # any non-space in worktree column => unstaged aspect
      if [[ "${xy:1:1}" != " " && "${xy:1:1}" != "?" ]]; then
        modified=$((modified + 1))
      fi
      # pure staged (M , A , …) still counts as change; if only staged, modified may be 0
      if [[ "${xy:1:1}" == " " && "${xy:0:1}" != " " && "${xy:0:1}" != "?" ]]; then
        : # staged-only already counted in staged
      fi
    fi
  done <<<"${porcelain}"
  local total
  total="$(printf '%s\n' "${porcelain}" | grep -c . || true)"
  printf '%s %s %s %s' "${modified}" "${staged}" "${untracked}" "${total}"
}

# ── findings for summary/doctor ──────────────────────────────────────────────
declare -a FINDINGS=()   # "LEVEL|CODE|message"
fail_count=0
warn_count=0
ok_count=0

add_finding() {
  local level="$1"   # OK | WARN | FAIL
  local code="$2"
  local message="$3"
  FINDINGS+=("${level}|${code}|${message}")
  case "${level}" in
    FAIL) fail_count=$((fail_count + 1)) ;;
    WARN) warn_count=$((warn_count + 1)) ;;
    OK)   ok_count=$((ok_count + 1)) ;;
  esac
}

print_finding() {
  local level="$1" code="$2" message="$3"
  local mark
  case "${level}" in
    OK)   mark="${C_OK}OK  ${C_RESET}" ;;
    WARN) mark="${C_WARN}WARN${C_RESET}" ;;
    FAIL) mark="${C_FAIL}FAIL${C_RESET}" ;;
    *)    mark="${level}" ;;
  esac
  printf '  %s %s%s%s %s\n' "${mark}" "${C_DIM}" "${code}" "${C_RESET}" "${message}"
}

# ── dump mode (legacy + dirty-only) ──────────────────────────────────────────
run_dump() {
  local repo_dir label dirty printed=0
  for repo_dir in "${repo_roots[@]}"; do
    dirty=false
    if repo_is_dirty "${repo_dir}"; then
      dirty=true
    fi
    if [[ "${mode_dirty_only}" == true && "${dirty}" != true ]]; then
      continue
    fi
    label="$(repo_label "${repo_dir}")"
    printf '\n[%s]\n' "${label}"
    git -C "${repo_dir}" status --short --branch
    if [[ "${show_submodules}" == true && -f "${repo_dir}/.gitmodules" ]]; then
      git -C "${repo_dir}" submodule status --recursive 2>/dev/null | sed 's/^/  submodule: /' || true
    fi
    printed=$((printed + 1))
  done
  if [[ "${mode_dirty_only}" == true && "${printed}" -eq 0 ]]; then
    printf '\n%sAll nested repos clean.%s\n' "${C_OK}" "${C_RESET}"
  fi
}

# ── summary mode ─────────────────────────────────────────────────────────────
declare -a DIRTY_REPOS=()
declare -a CLEAN_REPOS=()
dirty_nested=0
clean_nested=0
total_nested=0

collect_repo_stats() {
  local repo_dir label counts modified staged untracked total branch
  DIRTY_REPOS=()
  CLEAN_REPOS=()
  dirty_nested=0
  clean_nested=0
  total_nested=0

  for repo_dir in "${repo_roots[@]}"; do
    [[ "${repo_dir}" == "." ]] && continue
    total_nested=$((total_nested + 1))
    label="$(repo_label "${repo_dir}")"
    if repo_is_dirty "${repo_dir}"; then
      dirty_nested=$((dirty_nested + 1))
      counts="$(count_porcelain "${repo_dir}")"
      read -r modified staged untracked total <<<"${counts}"
      branch="$(repo_branch_line "${repo_dir}")"
      DIRTY_REPOS+=("${label}|${branch}|${modified}|${staged}|${untracked}|${total}")
    else
      clean_nested=$((clean_nested + 1))
      CLEAN_REPOS+=("${label}")
    fi
  done
}

run_summary_human() {
  local parent_branch parent_counts pm ps pu pt
  local entry label branch modified staged untracked total
  local health health_color

  parent_branch="$(repo_branch_line ".")"
  parent_counts="$(count_porcelain ".")"
  read -r pm ps pu pt <<<"${parent_counts}"

  if [[ "${fail_count}" -gt 0 ]]; then
    health="UNHEALTHY"
    health_color="${C_FAIL}"
  elif [[ "${dirty_nested}" -gt 0 || "${pt}" -gt 0 || "${warn_count}" -gt 0 ]]; then
    health="DIRTY"
    health_color="${C_WARN}"
  else
    health="CLEAN"
    health_color="${C_OK}"
  fi

  printf '\n%sWorkspace health: %s%s%s' "${C_BOLD}" "${health_color}" "${health}" "${C_RESET}"
  if [[ "${mode_doctor}" == true ]]; then
    printf '  %s(doctor: %s fail, %s warn, %s ok)%s' \
      "${C_DIM}" "${fail_count}" "${warn_count}" "${ok_count}" "${C_RESET}"
  fi
  printf '\n'

  printf '\n%s[mtt_workspace]%s %s\n' "${C_BOLD}" "${C_RESET}" "${parent_branch}"
  if [[ "${pt}" -gt 0 ]]; then
    printf '  changes: staged=%s unstaged=%s untracked=%s total=%s\n' "${ps}" "${pm}" "${pu}" "${pt}"
  else
    printf '  %sclean working tree%s\n' "${C_OK}" "${C_RESET}"
  fi

  printf '\n%sNested repos:%s %s dirty / %s clean / %s total\n' \
    "${C_BOLD}" "${C_RESET}" "${dirty_nested}" "${clean_nested}" "${total_nested}"

  if [[ "${#DIRTY_REPOS[@]}" -gt 0 ]]; then
    printf '\n%sDirty nested:%s\n' "${C_BOLD}" "${C_RESET}"
    for entry in "${DIRTY_REPOS[@]}"; do
      IFS='|' read -r label branch modified staged untracked total <<<"${entry}"
      printf '  %s%-42s%s  %s\n' "${C_WARN}" "${label}" "${C_RESET}" "${branch}"
      printf '    M=%s staged=%s ??= %s (lines=%s)\n' "${modified}" "${staged}" "${untracked}" "${total}"
    done
  fi

  if [[ "${mode_dirty_only}" != true && "${#CLEAN_REPOS[@]}" -gt 0 ]]; then
    printf '\n%sClean nested (%s):%s %s\n' \
      "${C_DIM}" "${#CLEAN_REPOS[@]}" "${C_RESET}" \
      "$(IFS=', '; echo "${CLEAN_REPOS[*]}")"
  fi
}

run_summary_json() {
  # Minimal JSON without requiring jq.
  local parent_branch parent_counts pm ps pu pt
  local entry label branch modified staged untracked total
  local first health
  parent_branch="$(repo_branch_line ".")"
  parent_counts="$(count_porcelain ".")"
  read -r pm ps pu pt <<<"${parent_counts}"

  if [[ "${fail_count}" -gt 0 ]]; then
    health="unhealthy"
  elif [[ "${dirty_nested}" -gt 0 || "${pt}" -gt 0 || "${warn_count}" -gt 0 ]]; then
    health="dirty"
  else
    health="clean"
  fi

  printf '{\n'
  printf '  "health": "%s",\n' "${health}"
  printf '  "parent": {\n'
  printf '    "branch_line": %s,\n' "$(json_escape "${parent_branch}")"
  printf '    "staged": %s,\n' "${ps}"
  printf '    "unstaged": %s,\n' "${pm}"
  printf '    "untracked": %s,\n' "${pu}"
  printf '    "total": %s\n' "${pt}"
  printf '  },\n'
  printf '  "nested": {\n'
  printf '    "dirty": %s,\n' "${dirty_nested}"
  printf '    "clean": %s,\n' "${clean_nested}"
  printf '    "total": %s,\n' "${total_nested}"
  printf '    "dirty_repos": [\n'
  first=true
  for entry in "${DIRTY_REPOS[@]+"${DIRTY_REPOS[@]}"}"; do
    [[ -z "${entry:-}" ]] && continue
    IFS='|' read -r label branch modified staged untracked total <<<"${entry}"
    if [[ "${first}" == true ]]; then first=false; else printf ',\n'; fi
    printf '      {"path": %s, "branch_line": %s, "unstaged": %s, "staged": %s, "untracked": %s, "total": %s}' \
      "$(json_escape "${label}")" "$(json_escape "${branch}")" \
      "${modified}" "${staged}" "${untracked}" "${total}"
  done
  printf '\n    ]\n'
  printf '  },\n'
  printf '  "findings": [\n'
  first=true
  local f level code message
  for f in "${FINDINGS[@]+"${FINDINGS[@]}"}"; do
    [[ -z "${f:-}" ]] && continue
    IFS='|' read -r level code message <<<"${f}"
    if [[ "${first}" == true ]]; then first=false; else printf ',\n'; fi
    printf '    {"level": %s, "code": %s, "message": %s}' \
      "$(json_escape "${level}")" "$(json_escape "${code}")" "$(json_escape "${message}")"
  done
  printf '\n  ],\n'
  printf '  "counts": {"fail": %s, "warn": %s, "ok": %s}\n' \
    "${fail_count}" "${warn_count}" "${ok_count}"
  printf '}\n'
}

json_escape() {
  # Escape a string as a JSON string literal.
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '"%s"' "${s}"
}

# ── doctor checks ────────────────────────────────────────────────────────────
run_doctor() {
  doctor_conflict_markers
  doctor_broken_symlinks
  doctor_gitmodules_vs_repos
  doctor_submodule_pointers
  doctor_untracked_packages
  doctor_staged_incomplete
  doctor_colcon_ignore_vs_demos
  doctor_latest_build

  if [[ "${mode_json}" != true ]]; then
    printf '\n%sDoctor checks:%s\n' "${C_BOLD}" "${C_RESET}"
    local f level code message
    if [[ "${#FINDINGS[@]}" -eq 0 ]]; then
      print_finding OK none "no findings"
      return
    fi
    for f in "${FINDINGS[@]}"; do
      IFS='|' read -r level code message <<<"${f}"
      print_finding "${level}" "${code}" "${message}"
    done
  fi
}

doctor_conflict_markers() {
  local hits
  hits="$(python3 - <<'PY' 2>/dev/null || true
from pathlib import Path
skip = {'.git', 'build', 'install', 'log', 'artifacts', 'graphify-out', '.ccache', '.cache', '.venv-tools', '__pycache__'}
binary_ext = {'.png', '.jpg', '.jpeg', '.pdf', '.vtk', '.ply', '.mp4', '.zip', '.o', '.so', '.a', '.pyc', '.bin', '.bag', '.db3'}
found = []
for p in Path('.').rglob('*'):
    if not p.is_file():
        continue
    if any(s in p.parts for s in skip):
        continue
    if p.suffix.lower() in binary_ext:
        continue
    try:
        data = p.read_bytes()[:200_000]
    except OSError:
        continue
    if b'\0' in data:
        continue
    text = data.decode('utf-8', 'ignore')
    for i, line in enumerate(text.splitlines(), 1):
        if line.startswith('<<<<<<<') or line.startswith('>>>>>>>'):
            found.append(f'{p}:{i}')
            if len(found) >= 20:
                break
    if len(found) >= 20:
        break
print('\n'.join(found))
PY
)"
  if [[ -z "${hits}" ]]; then
    add_finding OK conflict_markers "no merge conflict markers"
  else
    local n
    n="$(printf '%s\n' "${hits}" | grep -c . || true)"
    add_finding FAIL conflict_markers "${n} marker hit(s), e.g. $(printf '%s\n' "${hits}" | head -n 1)"
  fi
}

doctor_broken_symlinks() {
  local broken
  broken="$(find . -type l \
    ! -path './.git/*' ! -path './build/*' ! -path './install/*' ! -path './log/*' \
    ! -path './artifacts/*' ! -path './.ccache/*' ! -path './.cache/*' \
    -exec test ! -e {} \; -print 2>/dev/null | head -n 20 || true)"
  if [[ -z "${broken}" ]]; then
    add_finding OK symlinks "no broken symlinks in workspace surface"
  else
    local n
    n="$(printf '%s\n' "${broken}" | grep -c . || true)"
    add_finding FAIL symlinks "${n} broken symlink(s), e.g. $(printf '%s\n' "${broken}" | head -n 1)"
  fi
  # Explicitly check well-known links
  if [[ -L data ]]; then
    if [[ -e data ]]; then
      add_finding OK data_link "data -> $(readlink data)"
    else
      add_finding FAIL data_link "data symlink broken ($(readlink data))"
    fi
  fi
  if [[ -L results ]]; then
    if [[ -e results ]]; then
      add_finding OK results_link "results -> $(readlink results)"
    else
      add_finding WARN results_link "results symlink broken ($(readlink results))"
    fi
  fi
}

doctor_gitmodules_vs_repos() {
  if [[ ! -f .gitmodules ]]; then
    add_finding WARN manifests ".gitmodules missing"
    return
  fi
  if [[ ! -f dependencies/robot.repos ]]; then
    add_finding WARN manifests "dependencies/robot.repos missing"
    return
  fi

  local report
  report="$(python3 - <<'PY' 2>/dev/null || echo 'ERROR|python failed'
import re
from pathlib import Path

try:
    import yaml
except ImportError:
    print('WARN|pyyaml_missing|PyYAML not installed; skip robot.repos deep compare')
    raise SystemExit(0)

gm_text = Path('.gitmodules').read_text()
gm = {}
current = None
for line in gm_text.splitlines():
    m = re.match(r'\[submodule "([^"]+)"\]', line)
    if m:
        current = m.group(1)
        gm[current] = {}
        continue
    if current and '=' in line:
        k, v = line.split('=', 1)
        gm[current][k.strip()] = v.strip()

gm_paths = {v['path']: v for v in gm.values() if 'path' in v}
repos = yaml.safe_load(Path('dependencies/robot.repos').read_text())['repositories']
repo_paths = set(repos)

only_gm = sorted(set(gm_paths) - repo_paths)
only_repos = sorted(repo_paths - set(gm_paths))
if only_gm:
    print(f'FAIL|manifest_only_gitmodules|only in .gitmodules: {", ".join(only_gm)}')
if only_repos:
    print(f'FAIL|manifest_only_repos|only in robot.repos: {", ".join(only_repos)}')

mismatches = []
for path in sorted(set(gm_paths) & repo_paths):
    g, r = gm_paths[path], repos[path]
    if g.get('url') != r.get('url'):
        mismatches.append(f'{path} url')
    gbranch, rver = g.get('branch'), r.get('version')
    if gbranch and rver and gbranch != rver:
        mismatches.append(f'{path} branch/version ({gbranch} vs {rver})')
if mismatches:
    print(f'FAIL|manifest_mismatch|{"; ".join(mismatches[:8])}')
elif not only_gm and not only_repos:
    print(f'OK|manifests|aligned ({len(gm_paths)} entries)')

# Missing directories
missing = [p for p in sorted(gm_paths) if not Path(p).exists()]
if missing:
    print(f'FAIL|submodule_missing|{len(missing)} path(s) missing: {", ".join(missing[:5])}')
else:
    print(f'OK|submodule_dirs|all {len(gm_paths)} submodule paths exist')
PY
)"

  if [[ -z "${report}" ]]; then
    add_finding WARN manifests "unable to compare manifests"
    return
  fi
  local line level code message
  while IFS= read -r line; do
    [[ -z "${line}" ]] && continue
    IFS='|' read -r level code message <<<"${line}"
    add_finding "${level}" "${code}" "${message}"
  done <<<"${report}"
}

doctor_submodule_pointers() {
  if [[ ! -f .gitmodules ]]; then
    return
  fi
  local status_out bad
  status_out="$(git submodule status --recursive 2>/dev/null || true)"
  bad="$(printf '%s\n' "${status_out}" | grep -E '^[-+U]' || true)"
  if [[ -z "${bad}" ]]; then
    add_finding OK submodule_pointers "no uninitialized/mismatch/conflict submodule pointers"
  else
    local n sample
    n="$(printf '%s\n' "${bad}" | grep -c . || true)"
    sample="$(printf '%s\n' "${bad}" | head -n 1 | sed 's/^[[:space:]]*//')"
    # '+' is dirty content or different commit — often intentional WIP → WARN
    # '-' and 'U' are harder failures
    if printf '%s\n' "${bad}" | grep -qE '^[-U]'; then
      add_finding FAIL submodule_pointers "${n} bad pointer(s), e.g. ${sample}"
    else
      add_finding WARN submodule_pointers "${n} pointer(s) not at parent pin (+), e.g. ${sample}"
    fi
  fi
}

doctor_untracked_packages() {
  local report
  report="$(python3 - <<'PY' 2>/dev/null || true
import subprocess
from pathlib import Path

roots = []
if Path('src/mtt_core').is_dir():
    roots.append(Path('src/mtt_core'))
if Path('src/external').is_dir():
    roots.extend(sorted(p for p in Path('src/external').iterdir() if p.is_dir()))

untracked_pkgs = []
for root in roots:
    if not (root / '.git').exists() and not (root / '.git').is_file():
        # may still be a gitdir file for submodules
        gitdir = root / '.git'
        if not gitdir.exists():
            continue
    try:
        out = subprocess.check_output(
            ['git', '-C', str(root), 'ls-files', '--others', '--exclude-standard'],
            text=True, stderr=subprocess.DEVNULL,
        )
    except Exception:
        continue
    for rel in out.splitlines():
        p = root / rel
        if p.name == 'package.xml':
            untracked_pkgs.append(str(p.parent))
        # also catch untracked package directories containing package.xml
        if p.is_dir():
            pkg_xml = p / 'package.xml'
            if pkg_xml.is_file():
                # directory itself untracked ⇒ whole package untracked
                untracked_pkgs.append(str(p))

# Dedup
seen = []
for p in untracked_pkgs:
    if p not in seen:
        seen.append(p)

if not seen:
    print('OK|untracked_packages|no untracked ROS packages')
else:
    print(f'FAIL|untracked_packages|{len(seen)} untracked package(s): {", ".join(seen[:8])}')
PY
)"
  if [[ -z "${report}" ]]; then
    add_finding WARN untracked_packages "check skipped"
    return
  fi
  local level code message
  IFS='|' read -r level code message <<<"${report}"
  add_finding "${level}" "${code}" "${message}"
}

doctor_staged_incomplete() {
  # If .gitmodules is staged with romea/new entries but robot.repos is not staged
  # while it has local modifications, warn about incomplete integration commit.
  local staged unstaged
  staged="$(git diff --cached --name-only 2>/dev/null || true)"
  unstaged="$(git diff --name-only 2>/dev/null || true)"

  if printf '%s\n' "${staged}" | grep -qx '.gitmodules'; then
    if printf '%s\n' "${unstaged}" | grep -qx 'dependencies/robot.repos'; then
      add_finding WARN staged_incomplete \
        ".gitmodules staged but dependencies/robot.repos still unstaged (keep them aligned)"
    elif ! printf '%s\n' "${staged}" | grep -qx 'dependencies/robot.repos'; then
      # robot.repos not in staged and not modified — might already match or forgotten
      if git diff --quiet -- dependencies/robot.repos 2>/dev/null; then
        # also compare content presence of new submodule paths in robot.repos
        if git diff --cached -- .gitmodules | grep -q '^+\[submodule'; then
          add_finding WARN staged_incomplete \
            "new submodules staged in .gitmodules; confirm robot.repos lists them too"
        fi
      fi
    else
      add_finding OK staged_manifests ".gitmodules and robot.repos staging look consistent"
    fi

    if printf '%s\n' "${unstaged}" | grep -qx 'docker/Dockerfile'; then
      if git diff -- docker/Dockerfile 2>/dev/null | grep -qi 'gsl\|romea'; then
        add_finding WARN staged_incomplete \
          "Romea-related Dockerfile changes unstaged while submodules are staged"
      fi
    fi
  else
    add_finding OK staged_manifests "no partial .gitmodules staging detected"
  fi

  # Dirty content inside newly added submodules (Am state)
  local sm
  for sm in src/external/romea_core_common src/external/romea_core_path \
            src/external/romea_core_path_matching src/external/romea_path_tools; do
    if [[ -d "${sm}" ]] && repo_is_dirty "${sm}" 2>/dev/null; then
      add_finding WARN local_patches \
        "${sm} has local uncommitted changes (parent pin will not include them)"
    fi
  done
}

doctor_colcon_ignore_vs_demos() {
  local report
  report="$(python3 - <<'PY' 2>/dev/null || true
from pathlib import Path
import re

# Find packages that are under a COLCON_IGNORE ancestor but still referenced in demos/
ignored_pkg_names = set()
for ignore in Path('src').rglob('COLCON_IGNORE'):
    # package roots: this dir and children with package.xml
    base = ignore.parent
    for pkg_xml in base.rglob('package.xml'):
        # if any ancestor between base and pkg has another ignore, still ignored
        try:
            text = pkg_xml.read_text(errors='ignore')
        except OSError:
            continue
        m = re.search(r'<name>\s*([^<]+)\s*</name>', text)
        if m:
            ignored_pkg_names.add(m.group(1).strip())

if not ignored_pkg_names:
    print('OK|colcon_ignore|no COLCON_IGNORE packages under src/')
    raise SystemExit(0)

refs = []
demo_root = Path('demos')
if demo_root.is_dir():
    for f in list(demo_root.rglob('*.yaml')) + list(demo_root.rglob('*.yml')) + list(demo_root.rglob('*.py')) + list(demo_root.rglob('*.md')):
        try:
            text = f.read_text(errors='ignore')
        except OSError:
            continue
        for name in sorted(ignored_pkg_names):
            # word-ish reference
            if re.search(rf'(?<![\w-]){re.escape(name)}(?![\w-])', text):
                refs.append(f'{name} <- {f}')

# unique by package
by_pkg = {}
for r in refs:
    pkg, _, path = r.partition(' <- ')
    by_pkg.setdefault(pkg, set()).add(path)

if not by_pkg:
    print(f'OK|colcon_ignore|{len(ignored_pkg_names)} ignored package(s), none referenced in demos/')
else:
    detail = '; '.join(f'{k} ({len(v)} file(s))' for k, v in sorted(by_pkg.items())[:6])
    print(f'WARN|colcon_ignore_refs|demos reference COLCON_IGNORE package(s): {detail}')
PY
)"
  if [[ -z "${report}" ]]; then
    add_finding WARN colcon_ignore "check skipped"
    return
  fi
  local level code message
  IFS='|' read -r level code message <<<"${report}"
  add_finding "${level}" "${code}" "${message}"
}

doctor_latest_build() {
  local latest="log/latest_build"
  if [[ ! -e "${latest}" ]]; then
    add_finding WARN build_log "no log/latest_build (workspace not built here, or logs cleaned)"
    return
  fi
  if [[ ! -f "${latest}/events.log" ]]; then
    add_finding WARN build_log "log/latest_build has no events.log"
    return
  fi
  local bad
  bad="$(python3 - <<'PY' 2>/dev/null || true
import re
from pathlib import Path
text = Path('log/latest_build/events.log').read_text(errors='ignore')
bad = re.findall(r"\(([^)]+)\) CommandEnded: \{'returncode': ([1-9][0-9]*)\}", text)
if not bad:
    print('0')
else:
    print(str(len(bad)))
    for name, rc in bad[:8]:
        print(f'{name}:{rc}')
PY
)"
  local n
  n="$(printf '%s\n' "${bad}" | head -n 1)"
  if [[ "${n}" == "0" || -z "${n}" ]]; then
    local target
    target="$(readlink -f "${latest}" 2>/dev/null || printf '%s' "${latest}")"
    add_finding OK build_log "latest colcon build has no non-zero returncodes ($(basename "${target}"))"
  else
    local sample
    sample="$(printf '%s\n' "${bad}" | sed -n '2,4p' | tr '\n' ' ')"
    add_finding FAIL build_log "${n} non-zero job(s) in latest build: ${sample}"
  fi
}

# ── main ─────────────────────────────────────────────────────────────────────
exit_code=0

if [[ "${mode_dump}" == true ]]; then
  run_dump
fi

if [[ "${mode_summary}" == true || "${mode_doctor}" == true || "${mode_json}" == true ]]; then
  collect_repo_stats
fi

if [[ "${mode_doctor}" == true ]]; then
  run_doctor
fi

if [[ "${mode_summary}" == true ]]; then
  if [[ "${mode_json}" == true ]]; then
    # When doctor wasn't run, still emit empty findings.
    run_summary_json
  else
    run_summary_human
    if [[ "${mode_doctor}" != true && "${#FINDINGS[@]}" -eq 0 ]]; then
      # lightweight notes without full doctor
      if [[ "${dirty_nested}" -gt 0 ]]; then
        printf '\n%sTip:%s run %s./scripts/status --doctor%s for structural checks.\n' \
          "${C_DIM}" "${C_RESET}" "${C_BOLD}" "${C_RESET}"
      fi
    fi
  fi
fi

# Exit code policy
parent_dirty=0
if repo_is_dirty "."; then
  parent_dirty=1
fi

if [[ "${fail_count}" -gt 0 ]]; then
  exit_code=2
elif [[ "${dirty_nested}" -gt 0 || "${parent_dirty}" -gt 0 || "${warn_count}" -gt 0 ]]; then
  # Only force non-zero when summary/doctor/dirty-only requested, so legacy
  # `./scripts/status` keeps exit 0 for scripting that only greps output.
  if [[ "${mode_summary}" == true || "${mode_doctor}" == true || "${mode_dirty_only}" == true ]]; then
    exit_code=1
  fi
fi

if [[ "${mode_summary}" == true && "${mode_json}" != true ]]; then
  printf '\n%sexit=%s%s\n' "${C_DIM}" "${exit_code}" "${C_RESET}"
fi

exit "${exit_code}"
