#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname -- "${BASH_SOURCE[0]}")/.."

case "${1-}" in
  -h|--help)
    cat <<'EOF'
Usage: ./scripts/pull

Fast-forward the parent, then check out its exact recursive submodule pins.
Refuses local edits (including untracked files) before any fetch or checkout.
To upgrade a dependency, do it explicitly in that repository and review the
new parent pointer; this command does not follow dependency branch tips.
EOF
    exit 0 ;;
  '') ;;
  *) echo 'Usage: ./scripts/pull' >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { echo 'Usage: ./scripts/pull' >&2; exit 2; }

if [[ -n "$(git status --porcelain --untracked-files=all)" ]]; then
  echo '[pull] Local changes found. Commit or preserve them before updating.' >&2
  exit 1
fi
git submodule foreach --quiet --recursive '
  if test -n "$(git status --porcelain --untracked-files=all)"; then
    echo "[pull] Local changes in $displaypath; refusing update." >&2
    exit 1
  fi
'

git pull --ff-only
git submodule sync --recursive
git submodule update --init --recursive

status_output="$(git submodule status --recursive)"
if [[ "${status_output}" =~ (^|$'\n')[-+U] ]]; then
  echo '[pull] Submodule initialization/pin verification failed:' >&2
  printf '%s\n' "${status_output}" >&2
  exit 1
fi
echo '[pull] Parent and recursive submodule pins are synchronized.'
