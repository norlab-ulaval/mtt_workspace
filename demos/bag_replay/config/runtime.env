# ── Bag Replay Mapper Overrides ──
# These match the field-tuned live_robot values.
# Compose.yaml already provides fallback defaults for all MAPPING_* vars.

# Map publication: 0.05 Hz is enough for bag replay visualization
MAPPING_MAP_PUBLISH_RATE=0.05

# Tighter Z control than compose default (2.0→0.75)
MAPPING_MAX_Z_JUMP_M=0.75

# Pose step matches dynamic threshold at ~0.5s gap (8.0 * 0.5)
MAPPING_MAX_POSE_STEP_M=4.0

# Map insertion gates — tighter than pose gates
MAPPING_MAX_MAP_UPDATE_TRANSLATION_CORRECTION_M=1.50
MAPPING_MAX_MAP_UPDATE_ROTATION_CORRECTION_DEG=8.0

# Pivot detection thresholds
MAPPING_AGGRESSIVE_YAW_RATE_DEG_S=15.0
MAPPING_PIVOT_YAW_RATE_DEG_S=15.0
MAPPING_PIVOT_MAX_TRANSLATION_CORRECTION_M=0.60

# No trimming in bag replay — keeps full global map history
MAPPING_ENABLE_MAP_TRIMMING=false

# Odom bridge always allowed (no minimum speed gate)
MAPPING_ODOM_BRIDGE_MIN_SPEED_MS=0.0
