 "userNodes": {
  "icp_breadcrumbs": {
   "name": "/icp_breadcrumbs",
   "sourceCode": "import { Input, Message } from \"./types\";\n\ntype PoseArray = Message<\"geometry_msgs/PoseArray\">;\n\nexport const inputs = [\"/mapping/icp_odom\"];\nexport const output = \"/mapping/icp_path\";\n\nlet lastPoses: any[] = [];\nconst MAX_POSES = 50; // breadcrumb trail length\n\nexport default function script(msg: Input<\"/mapping/icp_odom\">): PoseArray {\n  lastPoses.push(msg.message.pose.pose);\n  if (lastPoses.length > MAX_POSES) {\n    lastPoses.shift();\n  }\n\n  return {\n    header: msg.message.header,\n    poses: lastPoses,\n  };\n}\n"
  }
 },
