# ZED capture profile. "isaac" grabs VGA(672x376)@60fps left+right rectified
# gray + raw IMU@200Hz -- required by isaac_vslam's VIO mode (added
# 2026-07-29 so this demo also gets VSLAM odometry for
# mtt_ice_slip_detector_node's fallback chain). "field" (this demo's old
# default) only grabs color, which VIO mode cannot use -- isaac_vslam would
# start but never actually track.
ZED_PROFILE=isaac

ENABLE_MAPPING=true
ENABLE_SENSORS=true
# Mathis COM-shift sessions are tractor-only: no trailer perception, no merged
# trailer cloud path. Keep these off unless a trailer is physically installed.
ENABLE_PERCEPTION=false
ENABLE_CLOUD_MERGER=false
ENABLE_TELEOP=true
ENABLE_JOYSTICK=true
ENABLE_GPS=true
ENABLE_OAK=false
ENABLE_MTI10=false

# Field/Doodle network mode.
# Keep false until the real Doodle-connected interface has been identified and
# configured with DOODLE_ROBOT_IP/24. When true, Zenoh and Foxglove bind to the
# Doodle robot IP instead of exposing all host interfaces.
FIELD_NETWORK_MODE=false
DOODLE_ROBOT_IP=192.168.50.2
DOODLE_PC_IP=192.168.50.101
FOXGLOVE_BIND_ADDRESS=192.168.50.2

# Lightweight remote visualization cloud. Raw /hesai_lidar/points stays local.
LIDAR_DEBUG_INPUT_TOPIC=/hesai_lidar/points
LIDAR_DEBUG_OUTPUT_TOPIC=/debug/hesai_points_voxel
LIDAR_DEBUG_VOXEL_SIZE=0.30
LIDAR_DEBUG_MAX_RATE_HZ=2.0
LIDAR_DEBUG_MAX_POINTS=25000

GPS_MODE=serial
GPS_ANTENNAS=front
OAK_MODE=stable

MAPPING_DELAY_SECONDS=10
MAPPING_POINTS_TOPIC=/hesai_lidar/points
MAPPING_CONFIG=demos/mathis_com_shift/config/mapper_snow_no_trailer.yaml
# norlab_icp_mapper_ros switched back to upstream ros2 2026-07-28 (see
# dependencies/robot.repos). Upstream only has a bool `deskew` (TF/odom-based
# deskewing, no IMU mode) — the same mechanism the comment below used to warn
# against (bakes wheel slip/articulation error into each point, swirl/double
# map). Keep deskew OFF, matching norlab_ws's proven-working mtt_mapper.launch.py.
MAPPING_DESKEW=false
MAPPING_DESKEW_IMU_TOPIC=/mti100/data
# Mathis mapper uses the standalone imu_odom_mti100 service as the odom TF
# authority. Keep the norlab_robot internal include disabled here because its
# current checkout launches imu_and_wheel_odom, not the Mathis/William imu_odom.
MAPPING_USE_IMU_ODOM=false
MAPPING_ENABLE_DYNAMIC_TRAILER_SELF_FILTER=false
MAPPING_ALLOW_ODOM_BRIDGE_MAP_INSERTION=false
MAPPING_COMPRESSION_VOXEL_SIZE=0.35
MAPPING_MAP_PUBLISH_RATE=0.05
MAPPING_MAP_TF_PUBLISH_RATE=50.0
# Quality gate thresholds for sparse snow/COM-shift sessions.
# Keep the input floor low enough for low-texture snow while still rejecting
# effectively empty scans.
MAPPING_MIN_INPUT_POINTS=150
# 2.0m / 28 deg allow for odom drift accumulation during short rejection windows.
# Dynamic threshold max(limit, 8.0*dt_since_accepted) grows further during cascades.
MAPPING_MAX_TRANSLATION_CORRECTION=2.00
MAPPING_MAX_ROTATION_CORRECTION_DEG=28.0
MAPPING_MAX_VELOCITY_MS=8.0
MAPPING_MAX_YAW_RATE_DEG_S=80.0
# 4.0m pose step matches dynamic threshold at ~0.5s gap (8.0 * 0.5).
MAPPING_MAX_POSE_STEP_M=4.0
MAPPING_MAX_Z_JUMP_M=0.75
# 3000ms gives the Jetson/NUC headroom under concurrent Zenoh + RViz + recording load.
MAPPING_MAX_REGISTRATION_TIME_MS=3000.0
# Live previously fell through to the launch default (10s), which is tight for
# a brief Zenoh/sensor hiccup and can self-shut-down the mapper. Match the
# validated bag-replay Mathis config (60s) instead of leaving this implicit.
MAPPING_MAX_IDLE_TIME=60.0
MAPPING_DETERMINISTIC_MAP_UPDATE_DISTANCE_M=0.03
MAPPING_DETERMINISTIC_MAP_UPDATE_YAW_DEG=0.5
MAPPING_DETERMINISTIC_MAP_MIN_DIST_NEW_POINT=0.03
# Map insertion is stricter than pose publication. ICP odom may keep publishing
# through difficult turns, but scans with large map-update corrections should not
# be fused into the persistent map.
MAPPING_MAX_MAP_UPDATE_TRANSLATION_CORRECTION_M=1.00
MAPPING_MAX_MAP_UPDATE_ROTATION_CORRECTION_DEG=6.0
# Treat low-speed z rotations as pivot-risk earlier than the pose gate. This
# preserves odom/path output while freezing map insertion when the correction is
# not clean enough for a new map scan.
MAPPING_AGGRESSIVE_SPEED_MS=2.0
MAPPING_AGGRESSIVE_YAW_RATE_DEG_S=15.0
MAPPING_PIVOT_LINEAR_SPEED_MS=0.75
MAPPING_PIVOT_YAW_RATE_DEG_S=15.0
MAPPING_PIVOT_MAX_TRANSLATION_CORRECTION_M=0.45
# Large-area mode: trimming OFF + cell-based disk storage (save_map_cells_on_hard_drive=true
# in _icp_mapper.yaml). The library offloads cells >40m from the robot to disk and reloads
# them on demand — global history preserved, memory bounded at ~40m active radius.
# Trimming (hard crop of internal ICP map) is incompatible with sensorMaxRange=80m:
# after a 40m trim the 40-80m ring has no coverage, estimateMapOverlap drops below
# threshold, and ICP rejects every scan until the robot backtracks.
MAPPING_ENABLE_MAP_TRIMMING=false
# Publish radius: crop the PointCloud2 sent to Foxglove to 40m around the robot.
# The ICP internal map is NOT affected — this is visualization bandwidth only.
MAPPING_MAP_PUBLISH_RADIUS_M=40.0

JOYSTICK_DEVICE=/dev/input/js0
JOYSTICK_DEADZONE=0.05

# ---- COM motor (CL86EC EtherCAT stepper) ----
# Start with: docker compose up com_motor -d
# COM_MOTOR_DRY_RUN=true  → test chain without hardware
# Leave COM_ETHERCAT_IFACE empty for auto-detection by Vendor/Product ID.
COM_MOTOR_DRY_RUN=false
COM_ETHERCAT_IFACE=enp6s0
COM_MOTOR_AUTO_ENABLE=true
COM_MOTOR_REQUIRED=true
COM_PARAMS_FILE=demos/mathis_com_shift/config/com_motor.yaml

# ---- Ice/snow slip diagnostics ----
ICE_SLIP_THRESHOLD=0.20
ICE_SLIP_MIN_CMD_SPEED_MS=0.05
ICE_SLIP_ICP_SPEED_VARIANCE=0.04
# Encoder/tachometer is intentionally weak in the 1D filter. Lower only after
# validating against ICP bags on ice.
ICE_SLIP_TACHO_SPEED_VARIANCE=1.00
ICE_COM_SHIFT_EXPERIMENT_ARM=true

# ---- COM direction switch: remote-controller button trigger ----
# Start with: docker compose --profile com_button up
# COM_BUTTON_SWITCH_INDEX must be set to a real sensor_msgs/Joy button index —
# -1 (default) leaves the node running but inert.
COM_BUTTON_SWITCH_INDEX=3
COM_BUTTON_SWITCH_COOLDOWN_S=0.5

# ---- COM direction switch: /sensor/speed threshold trigger ----
# Start with: docker compose --profile com_speed up
COM_SPEED_SWITCH_THRESHOLD_MS=2.0
COM_SPEED_SWITCH_HYSTERESIS_MS=0.2
COM_SPEED_SWITCH_COOLDOWN_S=1.0

EXTRA_RECORD_TOPICS="/imu_odom /ice_slip/slip_detected /ice_slip/slip_ratio /ice_slip/icp_slip_ratio /ice_slip/body_speed_ms /ice_slip/fused_speed_ms /ice_slip/tacho_speed_ms /ice_slip/cmd_speed_ms /ice_slip/driver_command_speed_ms /ice_slip/driver_effective_command_speed_ms /ice_slip/cmd_driver_delta_ms /ice_slip/auto_com_switch_enabled /ice_slip/com_direction_sign /slip_detected /mtt_control/com_mode /mtt_control/com_steer /mtt_control/com_direction_sign /mtt_control/ice_com_shift_experiment_active /mtt_control/ice_com_shift_armed /mtt_control/ice_com_shift_active /mtt_control/ice_com_shift_phase /motor/cmd_position /motor/joint_state /motor/driver_status /com_button_switch/enabled /com_button_switch/com_direction_sign /com_speed_switch/enabled /com_speed_switch/com_direction_sign /com_speed_switch/speed_ms /com_speed_switch/above_threshold"

# William/Mathis IMU-odom prior. This demo intentionally lets imu_odom publish
# odom->base_footprint, so the MTT driver must not publish the same TF.
ODOMETRY_BROADCAST_TF=false
IMU_ODOM_PARAMS_FILE=demos/mathis_com_shift/config/imu_odom_mti100.yaml
IMU_ODOM_TOPIC=/mti100/data
IMU_ODOM_OUTPUT_TOPIC=/imu_odom
IMU_ODOM_ICP_TOPIC=/mapping/icp_odom
IMU_ODOM_ROBOT_FRAME=base_footprint
IMU_ODOM_IMU_FRAME=imu_link
IMU_ODOM_ROTATION_ONLY=false
IMU_ODOM_USE_ALTITUDE=false
IMU_ODOM_REAL_TIME=true
MAPPING_ODOM_FRAME=odom
MAPPING_ROBOT_FRAME=base_footprint
